# FraudOps backend environment template.
#
# Copy to backend/.env and fill in real values locally. Never commit .env.
# Member 2 only needs the FRAUDOPS_INVESTIGATION_* variables; the remaining
# variables are owned by Members 1 and 4 and are listed for reference only.
# All values here are empty placeholders - no secrets are stored in git.

# --- Member 2: agentic investigation ---------------------------------------
# LLM access for evidence synthesis and recommendation narration.
# OPENAI_API_KEY is the variable name from the Technology Stack document;
# FRAUDOPS_INVESTIGATION_OPENAI_API_KEY is accepted as an alias.
# Leave both empty to force the deterministic fallback path (Agent System Design 16).
OPENAI_API_KEY=
FRAUDOPS_INVESTIGATION_OPENAI_API_KEY=
FRAUDOPS_INVESTIGATION_OPENAI_MODEL=
FRAUDOPS_INVESTIGATION_LLM_ENABLED=true
FRAUDOPS_INVESTIGATION_MAX_TOOL_RETRIES=2
FRAUDOPS_INVESTIGATION_INVESTIGATION_TIMEOUT_SECONDS=120
FRAUDOPS_INVESTIGATION_MIN_AUTO_INVESTIGATION_SEVERITY=HIGH
# memory | postgres (postgres requires Member 4's checkpointer)
FRAUDOPS_INVESTIGATION_CHECKPOINT_BACKEND=memory

# --- Member 1 / Member 4 (reference only, not used by Member 2) ------------
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fraudops
# JWT_SECRET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=
# SNS_TOPIC_ARN=
